# Example environment variables for task-executor
# Copy this file to .env and fill in your actual values

# Database connection (Neon PostgreSQL)
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# LLM API Keys
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Optional: LLM Configuration
LLM_PROVIDER=openai                    # openai or anthropic
OPENAI_MODEL=gpt-4o                    # OpenAI model to use
ANTHROPIC_MODEL=claude-3-sonnet-20240229  # Anthropic model to use
LLM_TEMPERATURE=0.1                    # Temperature for LLM responses
LLM_MAX_TOKENS=4000                    # Maximum tokens per response
LLM_TIMEOUT=30000                      # Request timeout in milliseconds

# Environment
NODE_ENV=development                   # development or production

# Optional: Browser Configuration
BROWSER_HEADLESS=true                  # Run browser in headless mode
BROWSER_TIMEOUT=60000                  # Browser timeout in milliseconds

# Optional: Email Notifications (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
NOTIFICATION_FROM_EMAIL=notifications@yourdomain.com  # Must be verified in Resend
NOTIFICATION_TO_EMAIL=your@email.com